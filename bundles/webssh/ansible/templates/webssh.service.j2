[Unit]
Description=WebSSH web-based SSH terminal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webssh
Group=webssh
ExecStart=/usr/bin/env wssh --address={{ webssh_address }} --port={{ webssh_port }}
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target

