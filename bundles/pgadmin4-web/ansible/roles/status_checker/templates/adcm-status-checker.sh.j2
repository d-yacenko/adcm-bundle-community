#!/usr/bin/env bash
set -euo pipefail

SERVICE_NAME="{{ service_name }}"
ADCM_URL="{{ adcm_connection_string }}"
HOST_ID="{{ host_id }}"
COMPONENT_ID="{{ component_id }}"
TOKEN="{{ token }}"

post() {
  local status="$1"  # 0 = OK, !=0 = NOT OK
  curl -sS \
    -H "Authorization: Token ${TOKEN}" \
    -H "Content-Type: application/json" \
    -d "{\"status\":${status}}" \
    -X POST "${ADCM_URL}/status/api/v1/host/${HOST_ID}/component/${COMPONENT_ID}/" \
    > /dev/null || true
}

while :; do
  if systemctl is-active -q "${SERVICE_NAME}"; then
    rc=0
  else
    rc=1
  fi
  post "$rc"
  sleep 5
done

