   "source": [
    "## Пример 7: Генераторы и списковые включения"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "example7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Squares from 1 to 10: [1, 4, 9, 16, 25, 36, 49, 64, 81, 100]\n",
      "Even squares: [4, 16, 36, 64, 100]\n",
      "Square dictionary: {1: 1, 2: 4, 3: 9, 4: 16, 5: 25}\n"
     ]
    }
   ],
   "source": [
    "# Генератор списка для квадратов чисел\n",
    "squares = [x**2 for x in range(1, 11)]\n",
    "print(\"Squares from 1 to 10:\", squares)\n",
    "\n",
    "# Генератор списка с условием (только четные)\n",
    "even_squares = [x**2 for x in range(1, 11) if x % 2 == 0]\n",
    "print(\"Even squares:\", even_squares)\n",
    "\n",
    "# Генератор словаря\n",
    "square_dict = {x: x**2 for x in range(1, 6)}\n",
    "print(\"Square dictionary:\", square_dict)"
   ]
  },
