   "id": "example9-title",
   "metadata": {},
   "source": [
    "## Пример 9: Классы и объектно-ориентированное программирование"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "example9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Using My Calculator\n",
      "10 + 5 = 15\n",
      "10 * 5 = 50\n",
      "\n",
      "History:\n",
      "  10 + 5 = 15\n",
      "  10 * 5 = 50\n"
     ]
    }
   ],
   "source": [
    "class Calculator:\n",
    "    \"\"\"Простой калькулятор.\"\"\"\n",
    "    \n",
    "    def __init__(self, name=\"Calculator\"):\n",
    "        self.name = name\n",
    "        self.history = []\n",
    "    \n",
    "    def add(self, a, b):\n",
    "        result = a + b\n",
    "        self.history.append(f\"{a} + {b} = {result}\")\n",
    "        return result\n",
    "    \n",
    "    def multiply(self, a, b):\n",
    "        result = a * b\n",
    "        self.history.append(f\"{a} * {b} = {result}\")\n",
    "        return result\n",
    "    \n",
    "    def show_history(self):\n",
    "        return self.history\n",
    "\n",
    "# Использование класса\n",
    "calc = Calculator(\"My Calculator\")\n",
    "print(f\"Using {calc.name}\")\n",
    "print(f\"10 + 5 = {calc.add(10, 5)}\")\n",
    "print(f\"10 * 5 = {calc.multiply(10, 5)}\")\n",
    "print(\"\\nHistory:\")\n",
    "for operation in calc.show_history():\n",
    "    print(f\"  {operation}\")"
   ]
  },
