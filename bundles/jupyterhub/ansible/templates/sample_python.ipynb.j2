   "source": [
    "import ipywidgets as widgets\n",
    "from IPython.display import display\n",
    "\n",
    "# Создаем слайдер и текстовое поле\n",
    "slider = widgets.IntSlider(\n",
    "    value=5,\n",
    "    min=0,\n",
    "    max=10,\n",
    "    step=1,\n",
    "    description='Число:',\n",
    ")\n",
    "\n",
    "label = widgets.Label(value=f\"Текущее значение: {slider.value}\")\n",
    "\n",
    "# Функция-обработчик изменения значения\n",
    "def on_value_change(change):\n",
    "    label.value = f\"Текущее значение: {change['new']}\"\n",
    "\n",
    "slider.observe(on_value_change, names='value')\n",
    "\n",
    "display(slider, label)\n"
   ]
