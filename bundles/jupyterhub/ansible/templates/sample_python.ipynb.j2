   "source": [
    "## Пример 10: Работа с датами и временем"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "example10",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Current date and time: 2025-11-22 21:31:10.789295\n",
      "Formatted: 2025-11-22 21:31:10\n",
      "In 7 days and 3 hours: 2025-11-30 00:31:10\n",
      "Days since 2020-01-01: 2152\n"
     ]
    }
   ],
   "source": [
    "from datetime import datetime, timedelta\n",
    "\n",
    "now = datetime.now()\n",
    "print(f\"Current date and time: {now}\")\n",
    "print(f\"Formatted: {now.strftime('%Y-%m-%d %H:%M:%S')}\")\n",
    "\n",
    "# Добавление времени\n",
    "future = now + timedelta(days=7, hours=3)\n",
    "print(f\"In 7 days and 3 hours: {future.strftime('%Y-%m-%d %H:%M:%S')}\")\n",
    "\n",
    "# Разница во времени\n",
    "past = datetime(2020, 1, 1)\n",
    "difference = now - past\n",
    "print(f\"Days since 2020-01-01: {difference.days}\")"
   ]
  },
