   "id": "example8-title",
   "metadata": {},
   "source": [
    "## Пример 8: Работа с файлами и исключениями"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "example8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "File content:\n",
      "Hello from Python!\n",
      "This is a test file.\n",
      "\n",
      "File size: 40 bytes\n",
      "Temporary file deleted.\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "import tempfile\n",
    "\n",
    "# Создание временного файла и запись данных\n",
    "with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt') as f:\n",
    "    f.write(\"Hello from Python!\\n\")\n",
    "    f.write(\"This is a test file.\\n\")\n",
    "    temp_file = f.name\n",
    "\n",
    "# Чтение файла\n",
    "try:\n",
    "    with open(temp_file, 'r') as f:\n",
    "        content = f.read()\n",
    "    print(\"File content:\")\n",
    "    print(content)\n",
    "    print(f\"File size: {os.path.getsize(temp_file)} bytes\")\n",
    "finally:\n",
    "    # Удаление временного файла\n",
    "    os.unlink(temp_file)\n",
    "    print(\"Temporary file deleted.\")"
   ]
  },
