  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "example12",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "File content:\n",
      "Hello from C#!\n",
      "This is a test file.\n",
      "File I/O example.\n",
      "\n",
      "File size: 54 bytes\n",
      "File deleted.\n"
     ]
    }
   ],
   "source": [
    "using System.IO;\n",
    "\n",
    "string filename = Path.Combine(Path.GetTempPath(), \"test_csharp_file.txt\");\n",
    "\n",
    "// Запись в файл\n",
    "File.WriteAllLines(filename, new[]\n",
    "{\n",
    "    \"Hello from C#!\",\n",
    "    \"This is a test file.\",\n",
    "    \"File I/O example.\"\n",
    "});\n",
    "\n",
    "// Чтение из файла\n",
    "string[] lines = File.ReadAllLines(filename);\n",
    "Console.WriteLine(\"File content:\");\n",
    "foreach (string line in lines)\n",
    "{\n",
    "    Console.WriteLine(line);\n",
    "}\n",
    "\n",
    "FileInfo fileInfo = new FileInfo(filename);\n",
    "Console.WriteLine($\"\\nFile size: {fileInfo.Length} bytes\");\n",
    "\n",
    "// Удаление файла\n",
