   "source": [
    "## Пример 10: Асинхронное программирование"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "example10",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Hello from async method!\n",
      "Parallel results: 10, 20, 30\n"
     ]
    }
   ],
   "source": [
    "using System.Threading.Tasks;\n",
    "\n",
    "async Task<string> GetMessageAsync()\n",
    "{\n",
    "    await Task.Delay(100); // Имитация асинхронной операции\n",
    "    return \"Hello from async method!\";\n",
    "}\n",
    "\n",
    "var message = await GetMessageAsync();\n",
    "Console.WriteLine(message);\n",
    "\n",
    "// Параллельное выполнение\n",
    "var tasks = new List<Task<int>>\n",
    "{\n",
    "    Task.Run(() => { Task.Delay(100).Wait(); return 10; }),\n",
    "    Task.Run(() => { Task.Delay(100).Wait(); return 20; }),\n",
    "    Task.Run(() => { Task.Delay(100).Wait(); return 30; })\n",
    "};\n",
    "\n",
    "var results = await Task.WhenAll(tasks);\n",
    "Console.WriteLine($\"Parallel results: {string.Join(\", \", results)}\");"
   ]
  },
