   "id": "example13-title",
   "metadata": {},
   "source": [
    "## Пример 13: Traits (интерфейсы)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "example13",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dog says Woof!\n",
      "Cat says Meow!\n",
      "The Dog says Woof!\n",
      "The Cat says Meow!\n"
     ]
    }
   ],
   "source": [
    "trait Animal {\n",
    "    fn make_sound(&self) -> &'static str;\n",
    "    fn name(&self) -> &'static str {\n",
    "        \"Unknown\"\n",
    "    }\n",
    "}\n",
    "\n",
    "struct Dog;\n",
    "struct Cat;\n",
    "\n",
    "impl Animal for Dog {\n",
    "    fn make_sound(&self) -> &'static str {\n",
    "        \"Woof!\"\n",
    "    }\n",
    "    \n",
    "    fn name(&self) -> &'static str {\n",
    "        \"Dog\"\n",
    "    }\n",
    "}\n",
    "\n",
    "impl Animal for Cat {\n",
    "    fn make_sound(&self) -> &'static str {\n",
    "        \"Meow!\"\n",
    "    }\n",
    "    \n",
    "    fn name(&self) -> &'static str {\n",
    "        \"Cat\"\n",
    "    }\n",
    "}\n",
    "\n",
    "let dog = Dog;\n",
    "let cat = Cat;\n",
    "\n",
    "println!(\"{} says {}\", dog.name(), dog.make_sound());\n",
