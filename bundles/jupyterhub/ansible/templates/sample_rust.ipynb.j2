   "id": "example11-title",
   "metadata": {},
   "source": [
    "## Пример 11: Работа с данными (serde)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "example11",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "USA      | 120\n",
      "Japan    | 110\n",
      "Germany  | 95\n",
      "Canada   | 80\n",
      "\n",
      "Total visits: 405, average: 101.2\n"
     ]
    }
   ],
   "source": [
    ":dep serde = { version = \"1.0\", features = [\"derive\"] }\n",
    "\n",
    "use serde::Deserialize;\n",
    "\n",
    "#[derive(Debug, Deserialize)]\n",
    "struct Record {\n",
    "    country: &'static str,\n",
    "    visits: u32,\n",
    "}\n",
    "\n",
    "let mut data: Vec<Record> = vec![\n",
    "    Record { country: \"USA\", visits: 120 },\n",
    "    Record { country: \"Canada\", visits: 80 },\n",
    "    Record { country: \"Germany\", visits: 95 },\n",
    "    Record { country: \"Japan\", visits: 110 },\n",
    "];\n",
    "\n",
    "data.sort_by(|a, b| b.visits.cmp(&a.visits)); // по убыванию\n",
    "\n",
    "for rec in &data {\n",
    "    println!(\"{:8} | {}\", rec.country, rec.visits);\n",
    "}\n",
    "\n",
    "// мини-«аналитика»\n",
    "let total: u32 = data.iter().map(|r| r.visits).sum();\n",
    "let avg = total as f32 / data.len() as f32;\n",
    "println!(\"\\nTotal visits: {total}, average: {avg:.1}\");"
   ]
  },
