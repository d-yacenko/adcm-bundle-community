   "metadata": {},
   "source": [
    "## Пример 6: Структуры и методы"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "example6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Person information:\n",
      "Name: Alice\n",
      "Age: 30\n",
      "City: Moscow\n",
      "\n",
      "After birthday:\n",
      "Name: Alice\n",
      "Age: 31\n",
      "City: Moscow\n"
     ]
    }
   ],
   "source": [
    "struct Person {\n",
    "    name: String,\n",
    "    age: u32,\n",
    "    city: String,\n",
    "}\n",
    "\n",
    "impl Person {\n",
    "    fn new(name: String, age: u32, city: String) -> Self {\n",
    "        Person { name, age, city }\n",
    "    }\n",
    "    \n",
    "    fn display_info(&self) {\n",
    "        println!(\"Name: {}\", self.name);\n",
    "        println!(\"Age: {}\", self.age);\n",
    "        println!(\"City: {}\", self.city);\n",
    "    }\n",
    "    \n",
    "    fn have_birthday(&mut self) {\n",
    "        self.age += 1;\n",
    "    }\n",
    "}\n",
    "\n",
    "let mut person = Person::new(\"Alice\".to_string(), 30, \"Moscow\".to_string());\n",
    "println!(\"Person information:\");\n",
    "person.display_info();\n",
    "\n",
    "person.have_birthday();\n",
    "println!(\"\\nAfter birthday:\");\n",
    "person.display_info();"
   ]
  },
