  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "example3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Vector: [10, 20, 30, 40, 50]\n",
