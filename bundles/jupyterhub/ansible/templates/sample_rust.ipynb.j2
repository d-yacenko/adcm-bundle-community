   "source": [
    "## Пример 9: Обработка ошибок (Result и Option)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "example9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "First element: 1\n",
      "No fifth element (index out of bounds)\n",
      "Division result: 5\n",
      "Error: Division by zero\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "()"
      ]
     },
     "execution_count": 10,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "// Option\n",
    "let numbers: Vec<i32> = vec![1, 2, 3];\n",
    "\n",
    "match numbers.get(0) {\n",
    "    Some(value) => println!(\"First element: {}\", value),\n",
    "    None => println!(\"No first element\"),\n",
    "}\n",
    "\n",
    "match numbers.get(5) {\n",
    "    Some(value) => println!(\"Fifth element: {}\", value),\n",
    "    None => println!(\"No fifth element (index out of bounds)\"),\n",
    "}\n",
    "\n",
    "// Result\n",
    "fn divide(a: f64, b: f64) -> Result<f64, String> {\n",
    "    if b == 0.0 {\n",
    "        Err(\"Division by zero\".to_string())\n",
    "    } else {\n",
    "        Ok(a / b)\n",
    "    }\n",
    "}\n",
    "\n",
    "match divide(10.0, 2.0) {\n",
    "    Ok(result) => println!(\"Division result: {}\", result),\n",
    "    Err(e) => println!(\"Error: {}\", e),\n",
    "}\n",
    "\n",
    "match divide(10.0, 0.0) {\n",
    "    Ok(result) => println!(\"Division result: {}\", result),\n",
    "    Err(e) => println!(\"Error: {}\", e),\n",
    "}\n"
   ]
