   "id": "example12-title",
   "metadata": {},
   "source": [
    "## Пример 12: Владение (Ownership) и заимствование (Borrowing)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "e015936d-e6d9-47ff-9b08-82434f312fe0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "s2: hello\n",
      "The length of 'world' is 5.\n",
      "Changed string: hello, world!\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "()"
      ]
     },
     "execution_count": 19,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "{\n",
    "    // Ownership\n",
    "    let s1 = String::from(\"hello\");\n",
    "    let s2 = s1; // s1 перемещается в s2\n",
    "    // println!(\"{}\", s1); // Ошибка! s1 больше не владеет данными\n",
    "    println!(\"s2: {}\", s2);\n",
    "\n",
    "    // Borrowing (ссылки)\n",
    "    let s3 = String::from(\"world\");\n",
    "    let len = calculate_length(&s3); // заимствование\n",
    "    println!(\"The length of '{}' is {}.\", s3, len); // s3 все еще доступна\n",
    "\n",
    "    fn calculate_length(s: &String) -> usize {\n",
    "        s.len()\n",
    "    }\n",
    "\n",
    "    // Mutable borrowing\n",
    "    let mut s4 = String::from(\"hello\");\n",
    "    change_string(&mut s4);\n",
    "    println!(\"Changed string: {}\", s4);\n",
    "\n",
    "    fn change_string(s: &mut String) {\n",
    "        s.push_str(\", world!\");\n",
    "    }\n",
    "}"
   ]
  },
