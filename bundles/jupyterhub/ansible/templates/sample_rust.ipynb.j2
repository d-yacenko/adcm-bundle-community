   "cell_type": "markdown",
   "id": "example7-title",
   "metadata": {},
   "source": [
    "## Пример 7: Enums и pattern matching"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "4ca89dce-368e-404b-ac5f-3ae0b9b0f51b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "System is active\n",
      "System is pending\n",
      "System is inactive\n",
      "Success: 42\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "()"
      ]
     },
     "execution_count": 16,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "enum Status {\n",
    "    Active,\n",
    "    Inactive,\n",
    "    Pending,\n",
    "}\n",
    "\n",
    "fn status_message(status: Status) -> &'static str {\n",
    "    match status {\n",
    "        Status::Active => \"System is active\",\n",
    "        Status::Inactive => \"System is inactive\",\n",
    "        Status::Pending => \"System is pending\",\n",
    "    }\n",
    "}\n",
    "\n",
    "// вот тут добавили явный тип\n",
    "let statuses: Vec<Status> = vec![Status::Active, Status::Pending, Status::Inactive];\n",
    "\n",
    "for status in statuses {\n",
    "    println!(\"{}\", status_message(status));\n",
    "}\n",
    "\n",
    "// Enum с данными\n",
    "enum MyResult<T, E> {\n",
    "    Ok(T),\n",
    "    Err(E),\n",
    "}\n",
    "\n",
    "let result: MyResult<i32, &str> = MyResult::Ok(42);\n",
    "match result {\n",
    "    MyResult::Ok(value) => println!(\"Success: {}\", value),\n",
    "    MyResult::Err(e) => println!(\"Error: {}\", e),\n",
    "}"
   ]
  },
