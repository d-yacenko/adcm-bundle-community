#!/usr/bin/env python3
"""
Jupyter kernel for BASIC (FreeBASIC).
Compiles and executes BASIC code using fbc (FreeBASIC Compiler).
"""
import json
import os
import sys
import tempfile
import subprocess
import shutil
import re

class BasicKernel:
    def __init__(self):
        self.temp_dir = None

    def execute_code(self, code):
        """Execute BASIC code."""
        # Create temporary directory for this execution
        self.temp_dir = tempfile.mkdtemp(prefix='basic_kernel_')
        
        try:
            # Simple cleanup: remove Jupyter prompt patterns [number]: or [ ]:
            cleaned_code = re.sub(r'\[\s*\d*\s*\]:\s*', '', code)
            
            # Write BASIC code to file
            basic_file = os.path.join(self.temp_dir, 'program.bas')
            with open(basic_file, 'w', encoding='utf-8') as f:
                f.write(cleaned_code)
            
            # Compile BASIC code
            compile_cmd = ['fbc', '-lang', 'qb', '-O', '2', basic_file, '-x', 'program']
            compile_result = subprocess.run(
                compile_cmd,
                cwd=self.temp_dir,
                capture_output=True,
                text=True,
                timeout=60
            )
            
            if compile_result.returncode != 0:
                error_output = compile_result.stderr or compile_result.stdout
                if not error_output:
                    error_output = 'Compilation failed with no output'
                return {
                    'status': 'error',
                    'output': error_output
                }
            
            # Execute compiled program
            exec_file = os.path.join(self.temp_dir, 'program')
            if not os.path.exists(exec_file):
                return {
                    'status': 'error',
                    'output': 'Compilation succeeded but executable not found'
                }
            
            exec_result = subprocess.run(
                [exec_file],
                cwd=self.temp_dir,
                capture_output=True,
                text=True,
                timeout=30
            )
            
            output = exec_result.stdout
            if exec_result.stderr:
                output += '\n' + exec_result.stderr
            
            # Ensure output is not None
            if output is None:
                output = ''
            
            return {
                'status': 'ok' if exec_result.returncode == 0 else 'error',
                'output': output,
                'return_code': exec_result.returncode
            }
        except subprocess.TimeoutExpired:
            return {
                'status': 'error',
                'output': 'Execution timeout (30 seconds)'
            }
        except Exception as e:
            return {
                'status': 'error',
                'output': f'Error: {str(e)}'
            }
        finally:
            # Cleanup
            if self.temp_dir and os.path.exists(self.temp_dir):
                try:
                    shutil.rmtree(self.temp_dir)
                except:
                    pass

from ipykernel.kernelbase import Kernel
from ipykernel.kernelapp import IPKernelApp

class BasicKernelImpl(Kernel):
    implementation = 'BASIC'
    implementation_version = '1.0'
    language = 'basic'
    language_version = 'FreeBASIC'
    language_info = {
        'name': 'basic',
        'mimetype': 'text/x-basic',
        'file_extension': '.bas',
    }
    banner = "BASIC (FreeBASIC) kernel"

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.basic = BasicKernel()

    def do_execute(self, code, silent, store_history=True,
                 user_expressions=None, allow_stdin=False):
        # Increment execution count
        self.execution_count += 1
        
        if not code.strip():
            return {
                'status': 'ok',
                'execution_count': self.execution_count,
                'payload': [],
                'user_expressions': {},
            }
        
        try:
            result = self.basic.execute_code(code)
            
            # Ensure result has required fields
            if 'status' not in result:
                result['status'] = 'error'
            if 'output' not in result:
                result['output'] = ''
            
            if not silent:
                if result['status'] == 'ok':
                    stream_content = {'name': 'stdout', 'text': result['output']}
                    self.send_response(self.iopub_socket, 'stream', stream_content)
                else:
                    stream_content = {'name': 'stderr', 'text': result['output']}
                    self.send_response(self.iopub_socket, 'stream', stream_content)
            
            return {
                'status': result['status'],
                'execution_count': self.execution_count,
                'payload': [],
                'user_expressions': {},
            }
        except Exception as e:
            error_msg = f'Kernel error: {str(e)}'
            if not silent:
                stream_content = {'name': 'stderr', 'text': error_msg}
                self.send_response(self.iopub_socket, 'stream', stream_content)
            return {
                'status': 'error',
                'execution_count': self.execution_count,
                'payload': [],
                'user_expressions': {},
            }

if __name__ == '__main__':
    IPKernelApp.launch_instance(kernel_class=BasicKernelImpl)

