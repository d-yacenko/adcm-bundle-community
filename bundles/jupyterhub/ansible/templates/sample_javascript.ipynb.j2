     "text": [
      "Start\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "Promise { <pending> }"
      ]
     },
     "execution_count": 9,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "After delay\n",
      "Done\n"
     ]
    }
   ],
   "source": [
    "function delay(ms) {\n",
    "    return new Promise(resolve => setTimeout(resolve, ms));\n",
    "}\n",
    "\n",
    "async function asyncExample() {\n",
    "    console.log('Start');\n",
    "    await delay(100);\n",
    "    console.log('After delay');\n",
    "    return 'Done';\n",
    "}\n",
    "\n",
    "asyncExample().then(result => console.log(result));\n"
   ]
  },
