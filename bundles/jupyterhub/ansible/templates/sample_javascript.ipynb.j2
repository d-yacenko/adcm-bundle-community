   "source": [
    "let numbers = [10, 20, 30, 40, 50];\n",
    "\n",
    "console.log('Array elements:');\n",
    "numbers.forEach((num, index) => {\n",
    "    console.log(`numbers[${index}] = ${num}`);\n",
    "});\n",
    "\n",
    "let asum = numbers.reduce((acc, num) => acc + num, 0);\n",
    "console.log(`\\nArray sum: ${asum}`);\n"
