    "## Пример 6: Объекты и классы\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {
    "vscode": {
     "languageId": "javascript"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Calculation history:\n",
      "25.5 + 4.2 = 29.7\n",
      "25.5 * 4.2 = 107.10000000000001\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "undefined"
      ]
     },
     "execution_count": 8,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "class Calculator {\n",
    "    constructor() {\n",
    "        this.history = [];\n",
    "    }\n",
    "    \n",
    "    add(a, b) {\n",
    "        let result = a + b;\n",
    "        this.history.push(`${a} + ${b} = ${result}`);\n",
    "        return result;\n",
    "    }\n",
    "    \n",
    "    multiply(a, b) {\n",
    "        let result = a * b;\n",
    "        this.history.push(`${a} * ${b} = ${result}`);\n",
    "        return result;\n",
    "    }\n",
    "    \n",
    "    showHistory() {\n",
    "        console.log('Calculation history:');\n",
    "        this.history.forEach(op => console.log(op));\n",
    "    }\n",
    "}\n",
    "\n",
    "let calc = new Calculator();\n",
    "calc.add(25.5, 4.2);\n",
    "calc.multiply(25.5, 4.2);\n",
    "calc.showHistory();\n"
   ]
  },
