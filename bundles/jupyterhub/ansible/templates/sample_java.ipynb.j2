   "source": [
    "import java.io.*;\n",
    "import java.nio.file.*;\n",
    "\n",
    "String filename = System.getProperty(\"java.io.tmpdir\") + \"/test_java_file.txt\";\n",
    "\n",
    "// Запись в файл\n",
    "try (PrintWriter writer = new PrintWriter(new FileWriter(filename))) {\n",
    "    writer.println(\"Hello from Java!\");\n",
    "    writer.println(\"This is a test file.\");\n",
    "    writer.println(\"File I/O example.\");\n",
    "}\n",
    "\n",
    "// Чтение из файла\n",
    "try (BufferedReader reader = Files.newBufferedReader(Paths.get(filename))) {\n",
    "    System.out.println(\"File content:\");\n",
    "    String line;\n",
    "    while ((line = reader.readLine()) != null) {\n",
    "        System.out.println(line);\n",
    "    }\n",
    "}\n",
    "\n",
    "File file = new File(filename);\n",
    "System.out.println(\"\\nFile size: \" + file.length() + \" bytes\");\n",
    "\n",
    "// Удаление файла\n",
    "file.delete();\n",
    "System.out.println(\"File deleted.\");"
   ]
