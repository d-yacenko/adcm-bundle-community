   "source": [
    "enum Status {\n",
    "    Pending = 'PENDING',\n",
    "    Active = 'ACTIVE',\n",
    "    Completed = 'COMPLETED'\n",
    "}\n",
    "\n",
    "function getStatusMessage(status: Status): string {\n",
    "    switch (status) {\n",
    "        case Status.Pending:\n",
    "            return 'Task is pending';\n",
    "        case Status.Active:\n",
    "            return 'Task is active';\n",
    "        case Status.Completed:\n",
    "            return 'Task is completed';\n",
    "    }\n",
    "}\n",
    "\n",
    "console.log(getStatusMessage(Status.Active));\n",
    "console.log(getStatusMessage(Status.Completed));\n"
   ]
