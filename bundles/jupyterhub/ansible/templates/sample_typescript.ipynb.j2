   "source": [
    "interface Person {\n",
    "    name: string;\n",
    "    age: number;\n",
    "    email?: string;\n",
    "}\n",
    "\n",
    "function displayPerson(person: Person): void {\n",
    "    console.log(`Name: ${person.name}`);\n",
    "    console.log(`Age: ${person.age}`);\n",
    "    if (person.email) {\n",
    "        console.log(`Email: ${person.email}`);\n",
    "    }\n",
    "}\n",
    "\n",
    "let user: Person = {\n",
    "    name: 'John Doe',\n",
    "    age: 30,\n",
    "    email: 'john@example.com'\n",
    "};\n",
    "\n",
    "displayPerson(user);\n"
   ]
