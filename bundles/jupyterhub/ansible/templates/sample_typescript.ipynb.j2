   "source": [
    "function getFirst<T>(items: T[]): T | undefined {\n",
    "    return items.length > 0 ? items[0] : undefined;\n",
    "}\n",
    "\n",
    "let unumbers: number[] = [10, 20, 30];\n",
    "let unames: string[] = ['Alice', 'Bob'];\n",
    "\n",
    "console.log('First number:', getFirst(unumbers));\n",
    "console.log('First name:', getFirst(unames));\n"
   ]
