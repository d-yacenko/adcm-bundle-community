    "type ID = string | number;\n",
    "\n",
    "function processId(id: ID): void {\n",
    "    if (typeof id === 'string') {\n",
    "        console.log(`String ID: ${id.toUpperCase()}`);\n",
    "    } else {\n",
    "        console.log(`Number ID: ${id}`);\n",
    "    }\n",
    "}\n",
    "\n",
    "processId('abc123');\n",
    "processId(12345);\n"
