   "metadata": {},
   "source": [
    "## Пример 3: Работа с массивами"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "example3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Array values:\n",
      "numbers[0] = 10\n",
      "numbers[1] = 20\n",
      "numbers[2] = 30\n",
      "numbers[3] = 40\n",
      "numbers[4] = 50\n",
      "\n",
      "Sum: 150\n",
      "Max: 50\n",
      "Min: 10\n",
      "Average: 30.00\n"
     ]
    }
   ],
   "source": [
    "#include <stdio.h>\n",
    "\n",
    "int main(void) {\n",
    "    int numbers[5];\n",
    "    int sum = 0;\n",
    "    int max, min;\n",
    "    \n",
    "    // Заполнение массива\n",
    "    printf(\"Array values:\\n\");\n",
    "    for (int i = 0; i < 5; i++) {\n",
    "        numbers[i] = (i + 1) * 10;\n",
    "        printf(\"numbers[%d] = %d\\n\", i, numbers[i]);\n",
    "    }\n",
    "    \n",
    "    // Поиск суммы, максимума и минимума\n",
    "    max = min = numbers[0];\n",
    "    for (int i = 0; i < 5; i++) {\n",
    "        sum += numbers[i];\n",
    "        if (numbers[i] > max) max = numbers[i];\n",
    "        if (numbers[i] < min) min = numbers[i];\n",
    "    }\n",
    "    \n",
    "    printf(\"\\nSum: %d\\n\", sum);\n",
    "    printf(\"Max: %d\\n\", max);\n",
    "    printf(\"Min: %d\\n\", min);\n",
    "    printf(\"Average: %.2f\\n\", (double)sum / 5);\n",
    "    \n",
    "    return 0;\n",
    "}"
   ]
  },
