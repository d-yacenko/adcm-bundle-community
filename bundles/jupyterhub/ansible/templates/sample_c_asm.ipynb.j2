   "source": [
    "## Пример 11: Дополнительный пример с ассемблером - вычисление суммы"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "example11",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "a = 15\n",
      "b = 27\n",
      "Sum (using inline assembly): 42\n",
      "Sum (using C): 42\n"
     ]
    }
   ],
   "source": [
    "#include <stdio.h>\n",
    "\n",
    "int main(void) {\n",
    "    int a = 15;\n",
    "    int b = 27;\n",
    "    int result;\n",
    "    \n",
    "    // Вычисление суммы с помощью inline assembly\n",
    "    __asm__ __volatile__ (\n",
    "        \"addl %1, %0\"\n",
    "        : \"=r\"(result)\n",
    "        : \"r\"(a), \"0\"(b)\n",
    "        : \"cc\"\n",
    "    );\n",
    "    \n",
    "    printf(\"a = %d\\n\", a);\n",
    "    printf(\"b = %d\\n\", b);\n",
    "    printf(\"Sum (using inline assembly): %d\\n\", result);\n",
    "    printf(\"Sum (using C): %d\\n\", a + b);\n",
    "    \n",
    "    return 0;\n",
    "}"
   ]
