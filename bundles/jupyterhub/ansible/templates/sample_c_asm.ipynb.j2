   "metadata": {},
   "source": [
    "## Пример 10: Встроенный ассемблер (Inline Assembly)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "example10",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "sysname: Linux\n",
      "release: 5.15.0-130-generic\n",
      "machine: x86_64\n"
     ]
    }
   ],
   "source": [
    "#include <stdio.h>\n",
    "#include <sys/utsname.h>\n",
    "\n",
    "int main(void) {\n",
    "    struct utsname uts;\n",
    "    long rc;\n",
    "\n",
    "    __asm__ __volatile__ (\n",
    "        \"movq $63, %%rax \\n\\t\"\n",
    "        \"movq %1, %%rdi  \\n\\t\"\n",
    "        \"syscall         \\n\\t\"\n",
    "        \"movq %%rax, %0\"\n",
    "        : \"=r\"(rc)\n",
    "        : \"r\"(&uts)\n",
    "        : \"%rax\", \"%rdi\", \"rcx\", \"r11\", \"memory\"\n",
    "    );\n",
    "\n",
    "    if (rc == 0) {\n",
    "        printf(\"sysname: %s\\nrelease: %s\\nmachine: %s\\n\",\n",
    "               uts.sysname, uts.release, uts.machine);\n",
    "    } else {\n",
    "        perror(\"syscall uname\");\n",
    "    }\n",
    "    return rc != 0;\n",
    "}"
   ]
  },
