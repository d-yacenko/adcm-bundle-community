    "## Пример 5: Работа со строками"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "example5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original string: C Programming\n",
      "Length: 13\n",
