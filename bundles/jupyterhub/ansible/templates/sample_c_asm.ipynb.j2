   "id": "example6-title",
   "metadata": {},
   "source": [
    "## Пример 6: Структуры"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "example6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Person information:\n",
      "Name: Alice\n",
      "Age: 30\n",
      "City: Moscow\n"
     ]
    }
   ],
   "source": [
    "#include <stdio.h>\n",
    "#include <string.h>\n",
    "\n",
    "struct Person {\n",
    "    char name[50];\n",
    "    int age;\n",
    "    char city[50];\n",
    "};\n",
    "\n",
    "void print_person(struct Person p) {\n",
    "    printf(\"Name: %s\\n\", p.name);\n",
    "    printf(\"Age: %d\\n\", p.age);\n",
    "    printf(\"City: %s\\n\", p.city);\n",
    "}\n",
    "\n",
    "int main(void) {\n",
    "    struct Person person;\n",
    "    \n",
    "    strcpy(person.name, \"Alice\");\n",
    "    person.age = 30;\n",
    "    strcpy(person.city, \"Moscow\");\n",
    "    \n",
    "    printf(\"Person information:\\n\");\n",
    "    print_person(person);\n",
    "    \n",
    "    return 0;\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "example7-title",
   "metadata": {},
   "source": [
    "## Пример 7: Указатели"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "example7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Before swap: x = 10, y = 20\n",
      "Address of x: 0x7ffe263c5af0\n",
      "Address of y: 0x7ffe263c5af4\n",
      "After swap: x = 20, y = 10\n"
     ]
    }
   ],
   "source": [
    "#include <stdio.h>\n",
    "\n",
    "void swap(int *a, int *b) {\n",
    "    int temp = *a;\n",
    "    *a = *b;\n",
    "    *b = temp;\n",
    "}\n",
    "\n",
    "int main(void) {\n",
    "    int x = 10;\n",
    "    int y = 20;\n",
    "    int *ptr_x = &x;\n",
    "    int *ptr_y = &y;\n",
    "    \n",
    "    printf(\"Before swap: x = %d, y = %d\\n\", x, y);\n",
    "    printf(\"Address of x: %p\\n\", (void*)ptr_x);\n",
    "    printf(\"Address of y: %p\\n\", (void*)ptr_y);\n",
    "    \n",
    "    swap(&x, &y);\n",
    "    \n",
    "    printf(\"After swap: x = %d, y = %d\\n\", x, y);\n",
    "    \n",
    "    return 0;\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "example8-title",
   "metadata": {},
   "source": [
    "## Пример 8: Динамическое выделение памяти"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "example8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dynamic array:\n",
      "arr[0] = 10\n",
      "arr[1] = 20\n",
      "arr[2] = 30\n",
      "arr[3] = 40\n",
      "arr[4] = 50\n",
      "\n",
      "After realloc:\n",
      "arr[0] = 10\n",
      "arr[1] = 20\n",
      "arr[2] = 30\n",
      "arr[3] = 40\n",
      "arr[4] = 50\n",
      "arr[5] = 60\n",
      "arr[6] = 70\n",
      "\n",
      "Memory freed.\n"
     ]
    }
   ],
   "source": [
    "#include <stdio.h>\n",
    "#include <stdlib.h>\n",
    "\n",
    "int main(void) {\n",
    "    int n = 5;\n",
    "    int *arr = (int*)malloc(n * sizeof(int));\n",
    "    \n",
    "    if (arr == NULL) {\n",
    "        printf(\"Memory allocation failed!\\n\");\n",
    "        return 1;\n",
    "    }\n",
    "    \n",
    "    // Заполнение массива\n",
    "    printf(\"Dynamic array:\\n\");\n",
    "    for (int i = 0; i < n; i++) {\n",
    "        arr[i] = (i + 1) * 10;\n",
    "        printf(\"arr[%d] = %d\\n\", i, arr[i]);\n",
    "    }\n",
    "    \n",
    "    // Изменение размера массива\n",
    "    arr = (int*)realloc(arr, (n + 2) * sizeof(int));\n",
    "    arr[n] = 60;\n",
    "    arr[n + 1] = 70;\n",
    "    \n",
    "    printf(\"\\nAfter realloc:\\n\");\n",
    "    for (int i = 0; i < n + 2; i++) {\n",
    "        printf(\"arr[%d] = %d\\n\", i, arr[i]);\n",
    "    }\n",
    "    \n",
    "    free(arr);\n",
    "    printf(\"\\nMemory freed.\\n\");\n",
    "    \n",
    "    return 0;\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "example9-title",
   "metadata": {},
   "source": [
    "## Пример 9: Работа с файлами"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "example9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "File content:\n",
      "Hello from C!\n",
      "This is a test file.\n",
      "File I/O example.\n",
      "\n",
      "File deleted.\n"
     ]
    }
   ],
   "source": [
    "#include <stdio.h>\n",
    "#include <stdlib.h>\n",
    "\n",
    "int main(void) {\n",
    "    FILE *file;\n",
    "    char filename[] = \"/tmp/test_c_file.txt\";\n",
    "    char buffer[100];\n",
    "    \n",
    "    // Запись в файл\n",
    "    file = fopen(filename, \"w\");\n",
    "    if (file == NULL) {\n",
    "        printf(\"Error opening file for writing!\\n\");\n",
    "        return 1;\n",
    "    }\n",
    "    \n",
    "    fprintf(file, \"Hello from C!\\n\");\n",
    "    fprintf(file, \"This is a test file.\\n\");\n",
    "    fprintf(file, \"File I/O example.\\n\");\n",
    "    fclose(file);\n",
    "    \n",
    "    // Чтение из файла\n",
    "    file = fopen(filename, \"r\");\n",
    "    if (file == NULL) {\n",
    "        printf(\"Error opening file for reading!\\n\");\n",
    "        return 1;\n",
    "    }\n",
    "    \n",
    "    printf(\"File content:\\n\");\n",
    "    while (fgets(buffer, sizeof(buffer), file) != NULL) {\n",
    "        printf(\"%s\", buffer);\n",
    "    }\n",
    "    \n",
    "    fclose(file);\n",
    "    remove(filename);\n",
    "    printf(\"\\nFile deleted.\\n\");\n",
    "    \n",
    "    return 0;\n",
    "}"
   ]
  },
