    "    printf(\"Length: %zu\\n\", strlen(name));\n",
    "    \n",
    "    // Конкатенация строк\n",
    "    strcpy(greeting, \"Hello, \");\n",
    "    strcat(greeting, name);\n",
    "    strcat(greeting, \"!\");\n",
    "    printf(\"Greeting: %s\\n\", greeting);\n",
    "    \n",
    "    // Сравнение строк\n",
    "    if (strcmp(name, \"C Programming\") == 0) {\n",
    "        printf(\"Strings are equal\\n\");\n",
    "    }\n",
    "    \n",
    "    return 0;\n",
    "}"
   ]
