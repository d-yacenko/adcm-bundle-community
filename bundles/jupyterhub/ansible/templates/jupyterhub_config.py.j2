# Generated by ADCM bundle
c.JupyterHub.base_url = '{{ base_url }}'
c.JupyterHub.ip = '{{ bind_host }}'
c.JupyterHub.port = {{ bind_port }}
c.JupyterHub.hub_port = {{ hub_port }}
c.JupyterHub.db_url = 'sqlite:////{{ data_dir }}/jupyterhub.sqlite'
c.JupyterHub.cookie_secret_file = '{{ data_dir }}/jupyterhub_cookie_secret'

c.Spawner.default_url = '/lab'
c.Spawner.cmd = ['{{ venv_dir }}/bin/{{ spawner_cmd }}']

# Ensure PATH for spawned single-user servers
c.Spawner.environment = {
    'PATH': '{{ env_path }}'
}
c.Spawner.env_keep = ['PATH']

c.JupyterHub.authenticator_class = 'jupyterhub.auth.PAMAuthenticator'
c.PAMAuthenticator.service = '{{ pam_service }}'

{% if allow_all %}
c.Authenticator.allow_all = True
{% endif %}

{% set admins = (admin_users | default('') | replace(',', ' ') ).split() %}
{% if admins %}
c.Authenticator.admin_users = { {% for u in admins %}'{{ u }}'{% if not loop.last %}, {% endif %}{% endfor %} }
{% endif %}
