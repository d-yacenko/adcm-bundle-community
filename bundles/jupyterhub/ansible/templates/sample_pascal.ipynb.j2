   "source": [
    "## Пример 5: Работа со строками"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "dcdde64b-e6ed-4cd8-96c8-fe76fc09ffda",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Hello, Pascal!\n",
      "Length of greeting: 14\n"
