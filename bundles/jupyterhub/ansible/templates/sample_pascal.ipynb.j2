   "source": [
    "program StringExample;\n",
    "var\n",
    "  name: string;\n",
    "  greeting: string;\n",
    "begin\n",
    "  name := 'Pascal';\n",
    "  greeting := 'Hello, ' + name + '!';\n",
    "  writeln(greeting);\n",
    "  writeln('Length of greeting: ', length(greeting));\n",
    "end."
   ]
