   "metadata": {},
   "source": [
    "## Пример 4: Простые функции"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "0bb28c06-b397-4f52-a337-6dab8cab5516",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Factorial of 5 is 120\n"
     ]
    }
   ],
   "source": [
    "program FunctionExample;\n",
    "\n",
    "function factorial(n: integer): integer;\n",
    "begin\n",
    "  if n <= 1 then\n",
    "    factorial := 1\n",
    "  else\n",
    "    factorial := n * factorial(n - 1);\n",
    "end;\n",
    "\n",
    "var\n",
    "  num: integer;\n",
    "begin\n",
    "  num := 5;\n",
    "  writeln('Factorial of ', num, ' is ', factorial(num));\n",
    "end."
   ]
  },
  {
