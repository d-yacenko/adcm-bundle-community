    "## Пример 6: Простой калькулятор"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "90147234-e056-4eba-81bf-15f2d86cca51",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Calculator Example:\n",
      "x = 25.50\n",
      "y = 4.20\n",
      "\n",
      "x + y = 29.70\n",
      "x - y = 21.30\n",
      "x * y = 107.10\n",
      "x / y = 6.07\n"
     ]
    }
   ],
   "source": [
    "program Calculator;\n",
    "var\n",
    "  x, y, result: real;\n",
    "begin\n",
    "  x := 25.5;\n",
    "  y := 4.2;\n",
    "  \n",
    "  writeln('Calculator Example:');\n",
    "  writeln('x = ', x:0:2);\n",
    "  writeln('y = ', y:0:2);\n",
    "  writeln;\n",
    "  \n",
    "  result := x + y;\n",
    "  writeln('x + y = ', result:0:2);\n",
    "  \n",
    "  result := x - y;\n",
    "  writeln('x - y = ', result:0:2);\n",
    "  \n",
    "  result := x * y;\n",
    "  writeln('x * y = ', result:0:2);\n",
    "  \n",
    "  result := x / y;\n",
    "  writeln('x / y = ', result:0:2);\n",
    "end."
   ]
  },
