   "source": [
    "## Пример 2: Математические вычисления"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "3c0690a4-ae12-49fb-8141-085dd620e571",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "a = 15\n",
      "b = 27\n",
      "Sum: 42\n",
      "Product: 405\n"
     ]
    }
   ],
   "source": [
    "program MathExample;\n",
    "var\n",
    "  a, b, sum, product: integer;\n",
    "begin\n",
    "  a := 15;\n",
    "  b := 27;\n",
    "  sum := a + b;\n",
    "  product := a * b;\n",
    "  \n",
    "  writeln('a = ', a);\n",
    "  writeln('b = ', b);\n",
    "  writeln('Sum: ', sum);\n",
    "  writeln('Product: ', product);\n",
    "end."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3cb85256-4e04-400e-b8a9-9333a860c294",
   "metadata": {},
   "source": [
    "## Пример 3: Работа с массивами"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "bcff40c1-4274-4a23-98e5-a181a27e0f0a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filling array with values:\n",
      "numbers[1] = 10\n",
      "numbers[2] = 20\n",
      "numbers[3] = 30\n",
      "numbers[4] = 40\n",
      "numbers[5] = 50\n",
      "\n",
      "Array sum:\n",
      "Total: 150\n"
     ]
    }
   ],
   "source": [
    "program ArrayExample;\n",
    "var\n",
    "  numbers: array[1..5] of integer;\n",
    "  i,sum: integer;\n",
    "begin\n",
    "  writeln('Filling array with values:');\n",
    "  for i := 1 to 5 do\n",
    "  begin\n",
    "    numbers[i] := i * 10;\n",
    "    writeln('numbers[', i, '] = ', numbers[i]);\n",
    "  end;\n",
    "  \n",
    "  writeln;\n",
    "  writeln('Array sum:');\n",
    "  sum := 0;\n",
    "  for i := 1 to 5 do\n",
    "    sum := sum + numbers[i];\n",
    "  writeln('Total: ', sum);\n",
    "end."
   ]
  },
  {
