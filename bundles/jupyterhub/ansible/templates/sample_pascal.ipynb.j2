   "source": [
    "## Пример 7: Простая игра (угадай число)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "c46ff634-febb-486d-820f-21c5878dd90e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Guessing game:\n",
      "Your guess: 35\n",
      "Too low! Try a higher number.\n"
     ]
    }
   ],
   "source": [
    "program GuessNumber;\n",
    "var\n",
    "  secret, guess: integer;\n",
    "begin\n",
    "  secret := 42;\n",
    "  guess := 35;\n",
    "  \n",
    "  writeln('Guessing game:');\n",
    "  writeln('Your guess: ', guess);\n",
    "  \n",
    "  if guess = secret then\n",
    "    writeln('Congratulations! You guessed it!')\n",
    "  else if guess < secret then\n",
    "    writeln('Too low! Try a higher number.')\n",
    "  else\n",
    "    writeln('Too high! Try a lower number.');\n",
    "end."
   ]
  }
