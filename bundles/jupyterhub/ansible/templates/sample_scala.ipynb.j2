    "## Пример 9: Option и обработка отсутствующих значений"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "example9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Found: Alice\n",
      "Not found\n",
      "Name 1: Alice\n",
      "Name 2: Unknown\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "defined \u001b[32mfunction\u001b[39m \u001b[36mfindName\u001b[39m\n",
       "\u001b[36mname1\u001b[39m: \u001b[32mOption\u001b[39m[\u001b[32mString\u001b[39m] = \u001b[33mSome\u001b[39m(value = \u001b[32m\"Alice\"\u001b[39m)\n",
       "\u001b[36mname2\u001b[39m: \u001b[32mOption\u001b[39m[\u001b[32mString\u001b[39m] = \u001b[32mNone\u001b[39m"
      ]
     },
     "execution_count": 8,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "def findName(id: Int): Option[String] = {\n",
    "  val names = Map(1 -> \"Alice\", 2 -> \"Bob\", 3 -> \"Charlie\")\n",
    "  names.get(id)\n",
    "}\n",
    "\n",
    "val name1 = findName(1)\n",
    "val name2 = findName(99)\n",
    "\n",
    "name1 match {\n",
    "  case Some(n) => println(s\"Found: $n\")\n",
    "  case None => println(\"Not found\")\n",
    "}\n",
    "\n",
    "name2 match {\n",
    "  case Some(n) => println(s\"Found: $n\")\n",
    "  case None => println(\"Not found\")\n",
    "}\n",
    "\n",
    "// Использование getOrElse\n",
    "println(s\"Name 1: ${name1.getOrElse(\"Unknown\")}\")\n",
    "println(s\"Name 2: ${name2.getOrElse(\"Unknown\")}\")"
   ]
  },
