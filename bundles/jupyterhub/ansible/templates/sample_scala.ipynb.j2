    "## Пример 15: Trait и полиморфизм"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "example15",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Circle: area = 78.53981633974483, perimeter = 31.41592653589793\n",
      "Rectangle: area = 24.0, perimeter = 20.0\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "defined \u001b[32mtrait\u001b[39m \u001b[36mShape\u001b[39m\n",
       "defined \u001b[32mclass\u001b[39m \u001b[36mCircle\u001b[39m\n",
       "defined \u001b[32mclass\u001b[39m \u001b[36mRectangle\u001b[39m\n",
       "\u001b[36mcircle\u001b[39m: \u001b[32mCircle\u001b[39m = \u001b[33mCircle\u001b[39m(radius = \u001b[32m5.0\u001b[39m)\n",
       "\u001b[36mrectangle\u001b[39m: \u001b[32mRectangle\u001b[39m = \u001b[33mRectangle\u001b[39m(width = \u001b[32m4.0\u001b[39m, height = \u001b[32m6.0\u001b[39m)\n",
       "\u001b[36mshapes\u001b[39m: \u001b[32mList\u001b[39m[\u001b[32mProduct\u001b[39m with \u001b[32mShape\u001b[39m with \u001b[32mSerializable\u001b[39m] = \u001b[33mList\u001b[39m(\n",
       "  \u001b[33mCircle\u001b[39m(radius = \u001b[32m5.0\u001b[39m),\n",
       "  \u001b[33mRectangle\u001b[39m(width = \u001b[32m4.0\u001b[39m, height = \u001b[32m6.0\u001b[39m)\n",
       ")"
      ]
     },
     "execution_count": 14,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "trait Shape {\n",
    "  def area(): Double\n",
    "  def perimeter(): Double\n",
    "}\n",
    "\n",
    "case class Circle(radius: Double) extends Shape {\n",
    "  def area(): Double = math.Pi * radius * radius\n",
    "  def perimeter(): Double = 2 * math.Pi * radius\n",
    "}\n",
    "\n",
    "case class Rectangle(width: Double, height: Double) extends Shape {\n",
    "  def area(): Double = width * height\n",
    "  def perimeter(): Double = 2 * (width + height)\n",
    "}\n",
    "\n",
    "val circle = Circle(5.0)\n",
    "val rectangle = Rectangle(4.0, 6.0)\n",
    "\n",
    "val shapes = List(circle, rectangle)\n",
    "shapes.foreach { shape =>\n",
    "  println(s\"${shape.getClass.getSimpleName}: area = ${shape.area()}, perimeter = ${shape.perimeter()}\")\n",
    "}"
   ]
  },
