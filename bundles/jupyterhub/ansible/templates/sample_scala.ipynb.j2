       "\u001b[36mfutureDate\u001b[39m: \u001b[32mLocalDateTime\u001b[39m = 2025-11-30T12:57:38.343659051\n",
       "\u001b[36mtoday\u001b[39m: \u001b[32mLocalDate\u001b[39m = 2025-11-23"
