   "source": [
    "import java.time.{LocalDateTime, LocalDate, Duration}\n",
    "\n",
    "val now = LocalDateTime.now()\n",
    "println(s\"Current date and time: $now\")\n",
    "\n",
    "val futureDate = now.plusDays(7)\n",
    "println(s\"Date in 7 days: $futureDate\")\n",
    "\n",
    "val today = LocalDate.now()\n",
    "println(s\"Today: $today\")\n",
    "println(s\"Year: ${today.getYear}\")\n",
    "println(s\"Month: ${today.getMonthValue}\")\n",
    "println(s\"Day: ${today.getDayOfMonth}\")"
