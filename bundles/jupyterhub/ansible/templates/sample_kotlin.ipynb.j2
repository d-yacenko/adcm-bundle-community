   "id": "example10-title",
   "metadata": {},
   "source": [
    "## Пример 10: Расширения функций (Extension Functions)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "example10",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original: 'Hello World'\n",
      "Without spaces: 'HelloWorld'\n",
      "\n",
      "42 is even: true\n",
      "Second element: 20\n"
     ]
    }
   ],
   "source": [
    "// Extension function для String\n",
    "fun String.removeSpaces(): String = this.replace(\" \", \"\")\n",
    "\n",
    "// Extension function для Int\n",
    "fun Int.isEven(): Boolean = this % 2 == 0\n",
    "\n",
    "// Extension function для List\n",
    "fun <T> List<T>.secondOrNull(): T? = if (this.size >= 2) this[1] else null\n",
    "\n",
    "val text = \"Hello World\"\n",
    "println(\"Original: '$text'\")\n",
    "println(\"Without spaces: '${text.removeSpaces()}'\")\n",
    "\n",
    "val number = 42\n",
    "println(\"\\n$number is even: ${number.isEven()}\")\n",
    "\n",
    "val list = listOf(10, 20, 30)\n",
    "println(\"Second element: ${list.secondOrNull()}\")"
   ]
  },
