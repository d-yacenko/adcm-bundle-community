   "cell_type": "markdown",
   "id": "example6-title",
   "metadata": {},
   "source": [
    "## Пример 6: Data классы и объектно-ориентированное программирование"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "example6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Person information:\n",
      "Name: Alice\n",
      "Age: 30\n",
      "City: Moscow\n",
      "\n",
      "ToString: Person(name=Alice, age=30, city=Moscow)\n",
      "\n",
      "Copied person with age changed: Person(name=Alice, age=31, city=Moscow)\n",
      "\n",
      "Destructured: name=Alice, age=30, city=Moscow\n"
     ]
    }
   ],
   "source": [
    "// Data class\n",
    "data class Person(val name: String, val age: Int, val city: String) {\n",
    "    fun displayInfo() {\n",
    "        println(\"Name: $name\")\n",
    "        println(\"Age: $age\")\n",
    "        println(\"City: $city\")\n",
    "    }\n",
    "}\n",
    "\n",
    "val person = Person(\"Alice\", 30, \"Moscow\")\n",
    "println(\"Person information:\")\n",
    "person.displayInfo()\n",
    "println(\"\\nToString: $person\")\n",
    "\n",
    "// Copy method (data class feature)\n",
    "val person2 = person.copy(age = 31)\n",
    "println(\"\\nCopied person with age changed: $person2\")\n",
    "\n",
    "// Destructuring\n",
    "val (name, age, city) = person\n",
    "println(\"\\nDestructured: name=$name, age=$age, city=$city\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "example7-title",
   "metadata": {},
   "source": [
    "## Пример 7: Map и работа с коллекциями"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "example7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Person information:\n",
      "  name: Alice\n",
      "  age: 30\n",
      "  city: Moscow\n",
      "  languages: [Kotlin, Java, Python]\n",
      "\n",
      "Number of languages: 3\n",
      "\n",
      "Mutable map: {a=1, b=2, c=3}\n"
     ]
    }
   ],
   "source": [
    "val person = mapOf(\n",
    "    \"name\" to \"Alice\",\n",
