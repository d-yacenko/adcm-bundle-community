    "## Пример 12: Использование библиотек (krangl и lets-plot)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "example12",
   "metadata": {},
   "outputs": [],
   "source": [
    "@file:Repository(\"file:///opt/jupyterhub/maven-local\")\n",
    "@file:Repository(\"https://repo1.maven.org/maven2\")\n",
    "@file:Repository(\"https://maven.pkg.jetbrains.space/public/p/lets-plot/maven\")\n",
    "@file:DependsOn(\"com.github.holgerbrandl:krangl:0.18.4\")\n",
    "@file:DependsOn(\"org.jetbrains.lets-plot:lets-plot-kotlin-jvm:4.11.0\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "example12-code",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Totals by category:\n",
      " - Books: 210.00 USD\n",
      " - Gadgets: 460.50 USD\n",
      " - Office: 75.00 USD\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "Plot(data={category=[Ljava.lang.String;@612c288b, total=[Ljava.lang.Double;@7743d45e}, mapping=org.jetbrains.letsPlot.intern.Options@178541bc, features=[org.jetbrains.letsPlot.geom.geomBar@64c52ebc])"
      ]
     },
     "execution_count": 32,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "import java.util.Locale\n",
    "import krangl.*\n",
    "import org.jetbrains.letsPlot.*\n",
    "import org.jetbrains.letsPlot.geom.*\n",
    "\n",
    "data class Sale(val category: String, val amount: Double)\n",
    "\n",
    "val sales = listOf(\n",
    "    Sale(\"Books\", 120.0),\n",
    "    Sale(\"Books\", 90.0),\n",
    "    Sale(\"Gadgets\", 310.0),\n",
    "    Sale(\"Gadgets\", 150.5),\n",
    "    Sale(\"Office\", 75.0)\n",
    ")\n",
    "\n",
    "val grouped = sales.groupBy { it.category }\n",
    "    .mapValues { (_, rows) -> rows.sumOf { it.amount } }\n",
    "    .toList()\n",
    "\n",
    "val flattened = grouped.flatMap { listOf(it.first, it.second) }\n",
    "val df = dataFrameOf(\"category\", \"total\")(*flattened.toTypedArray())\n",
    "\n",
    "val plot = letsPlot(df.toMap()) + geomBar(stat = Stat.identity) {\n",
    "    x = \"category\"; y = \"total\"\n",
    "}\n",
    "\n",
    "println(\"Totals by category:\")\n",
    "grouped.forEach { (category, total) ->\n",
    "    val formatted = String.format(Locale.US, \"%,.2f\", total)\n",
    "    println(\" - $category: $formatted USD\")\n",
    "}\n",
    "\n",
    "plot"
   ]
  },
