   "source": [
    "## Пример 11: Работа с файлами"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "example11",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "File content:\n",
      "Hello from Kotlin!\n",
      "This is a test file.\n",
      "File I/O example.\n",
      "\n",
      "File size: 57 bytes\n",
      "\n",
      "File lines:\n",
      "  1: Hello from Kotlin!\n",
      "  2: This is a test file.\n",
      "  3: File I/O example.\n",
      "\n",
      "File deleted.\n"
     ]
    }
   ],
   "source": [
    "import java.io.File\n",
    "\n",
    "val filename = \"${System.getProperty(\"java.io.tmpdir\")}/test_kotlin_file.txt\"\n",
    "\n",
    "// Запись в файл\n",
    "File(filename).writeText(\"\"\"\n",
    "    Hello from Kotlin!\n",
    "    This is a test file.\n",
    "    File I/O example.\n",
    "\"\"\".trimIndent())\n",
    "\n",
    "// Чтение из файла\n",
    "val content = File(filename).readText()\n",
    "println(\"File content:\")\n",
    "println(content)\n",
    "\n",
    "val file = File(filename)\n",
    "println(\"\\nFile size: ${file.length()} bytes\")\n",
    "\n",
    "// Чтение построчно\n",
    "println(\"\\nFile lines:\")\n",
    "File(filename).readLines().forEachIndexed { index, line ->\n",
    "    println(\"  ${index + 1}: $line\")\n",
    "}\n",
    "\n",
    "// Удаление файла\n",
    "file.delete()\n",
    "println(\"\\nFile deleted.\")"
   ]
  },
