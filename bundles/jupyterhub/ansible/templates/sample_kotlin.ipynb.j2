   "id": "example8-title",
   "metadata": {},
   "source": [
    "## Пример 8: Работа с датами и временем"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "example8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Current date and time: 2025-11-23T06:48:47.523625453\n",
      "Formatted: 2025-11-23 06:48:47\n",
      "In 7 days and 3 hours: 2025-11-30 09:48:47\n",
      "Days since 2020-01-01: 2153\n"
     ]
    }
   ],
   "source": [
    "import java.time.*\n",
    "import java.time.format.DateTimeFormatter\n",
    "import java.time.temporal.ChronoUnit\n",
    "\n",
    "val now = LocalDateTime.now()\n",
    "println(\"Current date and time: $now\")\n",
    "\n",
    "val formatter = DateTimeFormatter.ofPattern(\"yyyy-MM-dd HH:mm:ss\")\n",
    "println(\"Formatted: ${now.format(formatter)}\")\n",
    "\n",
    "// Добавление времени\n",
    "val future = now.plusDays(7).plusHours(3)\n",
    "println(\"In 7 days and 3 hours: ${future.format(formatter)}\")\n",
    "\n",
    "// Разница во времени\n",
    "val past = LocalDate.of(2020, 1, 1)\n",
    "val today = LocalDate.now()\n",
    "val days = ChronoUnit.DAYS.between(past, today)\n",
    "println(\"Days since 2020-01-01: $days\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "example9-title",
   "metadata": {},
   "source": [
    "## Пример 9: Обработка исключений"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "example9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Index out of range: Index 5 out of bounds for length 3\n",
      "Finally block executed.\n",
      "Division by zero: / by zero\n"
     ]
    }
   ],
   "source": [
    "try {\n",
    "    val numbers = arrayOf(1, 2, 3)\n",
    "    println(\"Number at index 5: ${numbers[5]}\") // ArrayIndexOutOfBoundsException\n",
    "} catch (e: ArrayIndexOutOfBoundsException) {\n",
    "    println(\"Index out of range: ${e.message}\")\n",
    "} catch (e: Exception) {\n",
    "    println(\"General error: ${e.message}\")\n",
    "} finally {\n",
    "    println(\"Finally block executed.\")\n",
    "}\n",
    "\n",
    "// Деление на ноль\n",
    "try {\n",
    "    val result = 10 / 0\n",
    "} catch (e: ArithmeticException) {\n",
    "    println(\"Division by zero: ${e.message}\")\n",
    "}"
   ]
  },
