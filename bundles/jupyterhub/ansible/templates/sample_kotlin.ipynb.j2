    "\n",
    "println(\"Person information:\")\n",
    "person.forEach { (key, value) ->\n",
    "    println(\"  $key: $value\")\n",
    "}\n",
    "\n",
    "val languages = person[\"languages\"] as? List<*>\n",
    "println(\"\\nNumber of languages: ${languages?.size ?: 0}\")\n",
    "\n",
    "// Mutable map\n",
    "val mutableMap = mutableMapOf(\"a\" to 1, \"b\" to 2)\n",
    "mutableMap[\"c\"] = 3\n",
    "println(\"\\nMutable map: $mutableMap\")"
   ]
