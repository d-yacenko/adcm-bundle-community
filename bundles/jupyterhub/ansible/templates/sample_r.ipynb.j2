      "\n",
      "File size: 53 bytes\n",
      "File deleted.\n"
     ]
    }
   ],
   "source": [
    "filename <- tempfile(\"test_r_file\", fileext = \".txt\")\n",
    "\n",
    "# Запись в файл\n",
    "writeLines(c(\"Hello from R!\", \"This is a test file.\", \"File I/O example.\"), filename)\n",
    "cat(\"File written successfully.\\n\")\n",
    "\n",
    "# Чтение из файла\n",
    "content <- readLines(filename)\n",
    "cat(\"\\nFile content:\\n\")\n",
    "for (line in content) {\n",
    "  cat(line, \"\\n\")\n",
    "}\n",
    "\n",
    "# Информация о файле\n",
    "file_info <- file.info(filename)\n",
    "cat(\"\\nFile size:\", file_info$size, \"bytes\\n\")\n",
    "\n",
    "# Удаление файла\n",
    "unlink(filename)\n",
    "cat(\"File deleted.\\n\")"
   ]
