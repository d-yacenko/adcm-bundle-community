    "# Преобразуем данные для графика\n",
    "sales_long <- tidyr::pivot_longer(sales, c(campaign_a, campaign_b),\n",
    "                                  names_to = \"campaign\", values_to = \"revenue\")\n",
    "\n",
    "# Создаем график с английскими метками для избежания предупреждений\n",
    "suppressWarnings({\n",
    "  p <- ggplot(sales_long, aes(x = month, y = revenue, fill = campaign)) +\n",
    "    geom_col(position = \"dodge\") +\n",
    "    geom_text(aes(label = revenue), vjust = -0.4,\n",
    "              position = position_dodge(width = 0.9), size = 3) +\n",
    "    labs(\n",
    "      title = \"Monthly Revenue of Campaigns A/B\",\n",
    "      x = \"Month\",\n",
    "      y = \"Revenue, thousands USD\",\n",
    "      fill = \"Campaign\"\n",
    "    ) +\n",
    "    theme_minimal()\n",
    "  print(p)\n",
    "})"
   ]
  },
