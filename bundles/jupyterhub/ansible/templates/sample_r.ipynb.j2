   "source": [
    "## Пример 8: Работа с датами и временем"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "example8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Current date and time: 2025-11-23 10:28:47 \n",
      "In 7 days and 3 hours: 2025-11-30 13:28:47 \n",
      "Days since 2020-01-01: 2153 \n",
      "Year: 2025 \n",
      "Month: 11 \n",
      "Day: 23 \n"
     ]
    }
   ],
   "source": [
    "now <- Sys.time()\n",
    "cat(\"Current date and time:\", format(now, \"%Y-%m-%d %H:%M:%S\"), \"\\n\")\n",
    "\n",
    "# Добавление времени\n",
    "future <- now + as.difftime(7, units = \"days\") + as.difftime(3, units = \"hours\")\n",
    "cat(\"In 7 days and 3 hours:\", format(future, \"%Y-%m-%d %H:%M:%S\"), \"\\n\")\n",
    "\n",
    "# Разница во времени\n",
    "past <- as.Date(\"2020-01-01\")\n",
    "today <- Sys.Date()\n",
    "days_diff <- as.numeric(today - past)\n",
    "cat(\"Days since 2020-01-01:\", days_diff, \"\\n\")\n",
    "\n",
    "# Извлечение компонентов\n",
    "cat(\"Year:\", format(now, \"%Y\"), \"\\n\")\n",
    "cat(\"Month:\", format(now, \"%m\"), \"\\n\")\n",
    "cat(\"Day:\", format(now, \"%d\"), \"\\n\")"
   ]
  },
