   "source": [
    "## Пример 9: Обработка исключений"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "example9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Result: NA \n",
      "Division result: Inf \n"
     ]
    }
   ],
   "source": [
    "# Обработка ошибок\n",
    "result <- tryCatch({\n",
    "  numbers <- c(1, 2, 3)\n",
    "  numbers[5]  # Index out of bounds\n",
    "}, error = function(e) {\n",
    "  cat(\"Error caught:\", e$message, \"\\n\")\n",
    "  return(NA)\n",
    "})\n",
    "\n",
    "cat(\"Result:\", result, \"\\n\")\n",
    "\n",
    "# Деление на ноль\n",
    "result2 <- tryCatch({\n",
    "  10 / 0\n",
    "}, warning = function(w) {\n",
    "  cat(\"Warning:\", w$message, \"\\n\")\n",
    "  return(Inf)\n",
    "})\n",
    "\n",
    "cat(\"Division result:\", result2, \"\\n\")"
   ]
  },
